{
  "info": {
    "name": "Travel Platform - D2 (blog, uploads, moderation, audit)",
    "description": "Manual test collection for BLG-01 to BLG-10, BLG-12, GEN-07 to GEN-10. Run the folders in order with the Collection Runner, or request by request. Authentication is the httpOnly cookie: each folder starts with its own sign-in. Folder 20 needs you to choose an image file. Folder 40 needs the seeded admin's credentials in the collection variables (never commit them). See docs/api/POSTMAN-D2.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Accounts for the run",
      "description": "Registers the two D2 test accounts (test_ prefix, as the shared-database rules require).",
      "item": [
        {
          "name": "Register the author (201, or 409 if it already exists)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "ACC-01. Run once; 409 EMAIL_ALREADY_REGISTERED on later runs is fine.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"D2 Test Author\",\n  \"email\": \"{{authorEmail}}\",\n  \"password\": \"{{authorPassword}}\",\n  \"acceptTerms\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register the reader (201, or 409 if it already exists)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "ACC-01. Run once; 409 EMAIL_ALREADY_REGISTERED on later runs is fine.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"D2 Test Reader\",\n  \"email\": \"{{readerEmail}}\",\n  \"password\": \"{{readerPassword}}\",\n  \"acceptTerms\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "10 Posts as the author (BLG-01 to BLG-04, BLG-08)",
      "item": [
        {
          "name": "Sign in as the author",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Stores the author's httpOnly cookie in Postman's cookie jar; every later request sends it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authorEmail}}\",\n  \"password\": \"{{authorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); const id = (b.user && b.user.id) || b.id; if (id) pm.collectionVariables.set('authorId', id);"
                ]
              }
            }
          ]
        },
        {
          "name": "01 Create a DRAFT (BLG-01)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "Saves postId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Three days in Luxor {{runTag}}\",\n  \"body\": \"We started at Karnak at sunrise, before the tour buses arrived.\",\n  \"tags\": [\n    \"Egypt\",\n    \" egypt \",\n    \"Nile  Cruise\"\n  ],\n  \"status\": \"DRAFT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 '.trim(), () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('draft, never published', () => { pm.expect(b.status).to.eql('DRAFT'); pm.expect(b.publishedAt).to.eql(null); });",
                  "pm.test('tags normalised (BLG-08)', () => pm.expect(b.tags).to.eql(['egypt', 'nile cruise']));",
                  "pm.collectionVariables.set('postId', b.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('runTag')) pm.collectionVariables.set('runTag', 'zq' + Date.now().toString(36));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Six tags are refused (BLG-08)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "400 with a field error on tags.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Too many tags\",\n  \"body\": \"x\",\n  \"status\": \"DRAFT\",\n  \"tags\": [\n    \"a\",\n    \"b\",\n    \"c\",\n    \"d\",\n    \"e\",\n    \"f\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 '.trim(), () => pm.response.to.have.status(400));",
                  "pm.test('code VALIDATION_FAILED', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_FAILED'));",
                  "pm.test('error on tags', () => pm.expect(pm.response.json().errors.map(e => e.field)).to.include('tags'));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 My posts include the draft (BLG-03)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "mine"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 '.trim(), () => pm.response.to.have.status(200));",
                  "pm.test('draft listed', () => pm.expect(pm.response.json().items.map(p => p.id)).to.include(pm.collectionVariables.get('postId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Publish it (BLG-04)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\",\n  \"tags\": [\n    \"egypt\",\n    \"luxor\",\n    \"{{runTag}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 '.trim(), () => pm.response.to.have.status(200));",
                  "pm.test('published with a date', () => { pm.expect(pm.response.json().status).to.eql('PUBLISHED'); pm.expect(pm.response.json().publishedAt).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Empty edit is refused",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 '.trim(), () => pm.response.to.have.status(400));",
                  "pm.test('code NOTHING_TO_UPDATE', () => pm.expect(pm.response.json().code).to.eql('NOTHING_TO_UPDATE'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "20 Images as the author (BLG-10, GEN-08)",
      "description": "Before running: open request 01, Body > form-data, and choose a JPG or PNG file for the key 'file'. Then try request 03 with a .gif, .txt or a file over 5 MB.",
      "item": [
        {
          "name": "01 Upload an image (choose a JPG/PNG first)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}",
                "images"
              ]
            },
            "description": "Multipart field 'file'. Saves imageUrl.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Pick a JPG or PNG of at most 5 MB"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 '.trim(), () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('served by URL', () => pm.expect(b.url).to.include('/images/'));",
                  "pm.collectionVariables.set('imageId', b.id);",
                  "pm.collectionVariables.set('imageUrl', b.url);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Download it",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/images/{{imageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}",
                "images",
                "{{imageId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 '.trim(), () => pm.response.to.have.status(200));",
                  "pm.test('image content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/image\\/(png|jpeg)/));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 A non-image is refused (choose a .txt or .gif)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}",
                "images"
              ]
            },
            "description": "Expect 400 INVALID_FILE_TYPE (or FILE_TOO_LARGE for a file over 5 MB). The type is checked on the bytes, so renaming a file to .png does not help.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Pick a JPG or PNG of at most 5 MB"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 '.trim(), () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "30 Reader: likes, comments, search, reports (BLG-02, 05 to 09, 12, GEN-09)",
      "item": [
