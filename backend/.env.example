# Copy this file to .env and fill in your own values. Never commit .env.
MONGODB_URI=
PORT=3000

# Signing secret for the access-token cookie (ACC-19). Any long random string;
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=

# Set to "production" only in a deployed environment. It makes the auth cookies
# Secure, which a browser will not send over plain http://localhost.
NODE_ENV=development

# Stripe TEST MODE keys (PAY-01). Both are optional: without them the rest of
# the app runs normally and only the payment endpoints answer 503, so a
# teammate who is not working on payments does not need a Stripe account.
# Never use a live key (sk_live_...) in this project.
#
# STRIPE_SECRET_KEY: Stripe dashboard > Developers > API keys > secret key
#   (test mode), it starts with sk_test_.
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: printed by `stripe listen --forward-to
#   localhost:3000/api/payments/webhook`, it starts with whsec_. Without it
#   every webhook delivery is rejected, because an unverified event is never
#   trusted.
STRIPE_WEBHOOK_SECRET=
