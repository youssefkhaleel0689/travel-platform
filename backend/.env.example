# Copy this file to .env and fill in your own values. Never commit .env.
MONGODB_URI=
PORT=3000

# Optional: exchange rates for itinerary budgets (FXRatesAPI).
# Leave both empty to use the default endpoint without a key.
# If you have a key, put it ONLY in your local .env, never in Git or an AI tool.
FXRATES_API_KEY=
FXRATES_API_URL=
