# Copy this file to .env and fill in your own values. Never commit .env.
MONGODB_URI=
PORT=3000

# Signing secret for the access-token cookie (ACC-19). Any long random string;
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=

# Set to "production" only in a deployed environment. It makes the auth cookies
# Secure, which a browser will not send over plain http://localhost.
NODE_ENV=development
