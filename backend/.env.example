# Copy this file to .env and fill in your own values. Never commit .env.
MONGODB_URI=
PORT=3000
BCRYPT_COST=12
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Stripe TEST MODE keys (PAY-01). The placeholders below are enough to run the
# app and the whole test suite - `npm run test:e2e` needs both set to something,
# because the payment suites sign their own webhook deliveries with whatever the
# app verifies against, and an unset STRIPE_SECRET_KEY makes every payment
# endpoint answer 503 before the test reaches its assertion. Nothing here is a
# secret: they are not real keys and no request ever leaves the machine during
# the tests, which stand in for Stripe's HTTP API.
#
# Replace them with your own test-mode keys only when you are demonstrating a
# real payment. Never use a live key (sk_live_...) in this project.
#
# STRIPE_SECRET_KEY: Stripe dashboard > Developers > API keys > secret key
#   (test mode), it starts with sk_test_. With the placeholder, a real payment
#   call reaches Stripe and is refused, so the endpoints answer 503
#   STRIPE_UNAVAILABLE instead of 503 PAYMENTS_UNAVAILABLE. Leave it empty if
#   you would rather have the second, clearer message and are not running the
#   payment tests.
STRIPE_SECRET_KEY=sk_test_placeholder
# STRIPE_WEBHOOK_SECRET: for a live demo, `stripe listen --print-secret` prints
#   the real one (see README "Environment and running it locally"); it starts
#   with whsec_. Without it
#   every webhook delivery is rejected, because an unverified event is never
#   trusted, and the payment e2e suites stop with a message saying so.
STRIPE_WEBHOOK_SECRET=whsec_local_test_only

# UPLOADS_DIR: where uploaded images are stored (GEN-08). Optional; default
#   ./uploads next to where the server starts. Never committed.
UPLOADS_DIR=

# Optional: exchange rates for itinerary budgets (FXRatesAPI).
# Leave both empty to use the default endpoint without a key.
# If you have a key, put it ONLY in your local .env, never in Git or an AI tool.
FXRATES_API_KEY=
FXRATES_API_URL=

# GEN-01-B: email delivery of in-app notifications using a test inbox.
# Off by default; setting SMTP_ENABLE=true with no SMTP_HOST only logs a warning.
SMTP_ENABLE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@travel-platform.local
